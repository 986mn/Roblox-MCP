{
  "name": "roblox-mcp-server",
  "version": "1.0.0",
  "description": "An MCP server for interacting with Roblox Game Clients",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "roblox-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "connector.luau",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/copy-assets.mjs",
    "install:harness": "node scripts/install-harnesses.mjs",
    "install:harnesses": "node scripts/install-harnesses.mjs",
    "getscript": "node scripts/install-harnesses.mjs --get-script",
    "start": "node dist/index.js",
    "update": "node scripts/install-harnesses.mjs --update",
    "prepare": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.27.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "monaco-editor": "^0.56.0",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2"
  }
}
